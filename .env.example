# Copy to .env.local. Local development uses disk-backed PGlite.
APP_URL=http://localhost:3000
DATABASE_PATH=.data/meet
# DATABASE_URL=postgresql://user:password@localhost:5432/meet
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Optional Playground server-to-server SSO, minimum 32 random characters
# PLAYGROUND_SSO_SECRET=
# Production must set all URLs to HTTPS/WSS and replace dev credentials.
